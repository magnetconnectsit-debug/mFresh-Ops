      "toolArgs": [
        "run",
        "melos",
        "bootstrap"
      ]
    },
    {
      "name": "Melos: Clean",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}",
      "program": "packages/apps/mfresh/lib/main.dart",
      "toolArgs": [
        "run",
        "melos",
        "clean"
      ]
    }
  ]
