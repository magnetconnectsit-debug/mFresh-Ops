      "program": "packages/apps/mfresh/lib/main.dart"
    },
    {
      "name": "mfresh_ops (Debug)",
      "request": "launch",
      "type": "dart",
      "program": "packages/apps/mfresh_ops/lib/main.dart"
    },
    {
      "name": "Melos: Bootstrap",
